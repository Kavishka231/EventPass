DATABASE_URL=jdbc:postgresql://localhost:5432/eventpass
DATABASE_USERNAME=eventpass
DATABASE_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-a-redis-secret
REDIS_CONNECT_TIMEOUT=PT2S
REDIS_COMMAND_TIMEOUT=PT1S
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="eventpass" password="replace-with-a-kafka-secret";
KAFKA_CONSUMER_GROUP=eventpass-notifications-v1
KAFKA_TOPIC_PROVISIONING_ENABLED=true
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_DLT_RETENTION_MS=2592000000
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eventpass
JWT_AUDIENCE=eventpass-api
JWT_SIGNING_KEY_ID=eventpass-primary
CORS_ALLOWED_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
