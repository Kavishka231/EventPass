DATABASE_URL=jdbc:postgresql://localhost:5432/eventpass
DATABASE_USERNAME=eventpass
DATABASE_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=eventpass-notifications-v1
KAFKA_TOPIC_PROVISIONING_ENABLED=true
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_DLT_RETENTION_MS=2592000000
KAFKA_CONSUMER_CONCURRENCY=3
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eventpass
JWT_AUDIENCE=eventpass-api
JWT_SIGNING_KEY_ID=eventpass-primary
CORS_ALLOWED_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
